<tr data-search="[#_row.search#]" data-deleted="[#_row.deleted#]" x-show="shows($el)">
    <td class="whitespace-nowrap" title="[#_row.date#]">[#_row.when#]</td>
    <td><a class="link" href="[#base-url#]/nb-admin/[#get history-slug#]/[#_row.uuid#]/history">[#_row.title#]</a></td>
    <td>[#_row.who#] [#_row.badge#]</td>
    <td>[#text [#_row.label#]#] <span class="text-neutral-500">[#_row.changed#]</span></td>
    <td class="whitespace-nowrap text-right">[#_row.button#] [#_row.forget#]</td>
</tr>
